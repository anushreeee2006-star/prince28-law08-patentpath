# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=patentpath
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Optional Cloudflare R2 object storage.
# Leave blank to use local storage only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto
